# ──────────────────────────────────────────────
# Environment variables — non-sensitive only
# Sensitive values (DATABASE_URL, TELEGRAM_BOT_TOKEN)
# are stored in AWS SSM Parameter Store
# ──────────────────────────────────────────────

# Target environment: dev | sit | prod
APP_ENV=dev

# When true, extra debug info is logged
DEBUG=false

# ── Database ──────────────────────────────────
DATABASE_ECHO=false
DB_SCHEMA=gratitude_bot
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── Telegram ──────────────────────────────────
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# ── Security ──────────────────────────────────
SECRET_KEY=change-me-in-production
CORS_ORIGINS=["*"]

# ── Logging ───────────────────────────────────
LOG_LEVEL=INFO
