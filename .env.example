# ──────────────────────────────────────────────
# Environment variables — all supported fields
# Copy relevant vars to .env.dev / .env.sit / .env.prod
# ──────────────────────────────────────────────

# Target environment: dev | sit | prod
APP_ENV=dev

# When true, extra debug info is logged
DEBUG=false

# ── Database ──────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gratitude_bot
DATABASE_ECHO=false
DB_SCHEMA=gratitude_bot
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── Telegram ──────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# ── Security ──────────────────────────────────
SECRET_KEY=change-me-in-production
CORS_ORIGINS=["*"]

# ── Logging ───────────────────────────────────
LOG_LEVEL=INFO

# ── SSM Parameter Store (prod only) ───────────
SSM_ENABLED=false
SSM_PARAMETER_PATH=/gratitude-bot
